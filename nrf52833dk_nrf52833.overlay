/ {
    aliases {
        led4 = &my_led4;
    };

    leds {
        compatible = "gpio-leds";
        my_led4: led_4 {
            gpios = <&gpio0 5 GPIO_ACTIVE_LOW>; /* P0.05 */
            label = "User LED 4";
        };
    };
};


&i2c0 {
    TLV493: TLV493@1f {
        compatible = "i2c-device";
        reg = <0x1f>;
        label = "TLV493D";
        status = "okay";
 
    };
};


&egu0 {
    status = "disabled";
};

&ccm {
    status = "disabled";
};
